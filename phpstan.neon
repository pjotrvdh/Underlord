includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/phpstan/phpstan-deprecation-rules/rules.neon

parameters:
    tmpDir: .phpstan.cache

    paths:
        - app
        - bootstrap
        - database
        - routes
    excludePaths:
        - bootstrap/cache

    # Level 9 is the highest level
    level: max

{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "awcodes/filament-gravatar": "^4.2",
        "awcodes/light-switch": "^3.2",
        "codewithdennis/filament-lucide-icons": "^4.1",
        "dutchcodingcompany/filament-developer-logins": "^2.1",
        "filament/filament": "^5.0",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "pxlrbt/filament-environment-indicator": "^3.6",
        "stechstudio/filament-impersonate": "^5.6",
        "swisnl/filament-backgrounds": "^2.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.6",
        "fakerphp/faker": "^1.23",
        "larastan/larastan": "^3.12",
        "laravel/boost": "^2.10",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpunit/phpunit": "^12.5.12",
        "rector/rector": "^2.7",
        "swisnl/laravel-boost-extras": "^0.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install --ignore-scripts",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "test": [
            "@php artisan optimize:clear --quiet",
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "if [ \"$COMPOSER_DEV_MODE\" = \"1\" ] ; then php artisan boost:update --ansi ; fi",
            "@publish-assets"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ],
        "analyse": [
            "@php artisan optimize:clear --quiet",
            "vendor/bin/phpstan analyse --ansi"
        ],
        "format": [
            "vendor/bin/rector process",
            "vendor/bin/pint --parallel"
        ],
        "format-check": [
            "@php artisan optimize:clear --quiet",
            "vendor/bin/rector process --dry-run",
            "vendor/bin/pint --parallel --bail"
        ],
        "post-install-cmd": [
            "if [ \"$COMPOSER_DEV_MODE\" = \"1\" ] ; then php artisan boost:update --ansi ; fi",
            "@publish-assets"
        ],
        "publish-assets": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan filament:assets"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "policy": {
            "abandoned": {
                "ignore": {
                    "symplify/rule-doc-generator-contracts": "Transitive dev dependency of driftingly/rector-laravel 2.6.2; no replacement is currently available."
                }
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
